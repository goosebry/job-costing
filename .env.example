# ════════════════════════════════════════════════════════
#  Environment Variables — copy to .env and fill in values
#  Also set ALL of these in: Vercel → Project → Settings → Environment Variables
# ════════════════════════════════════════════════════════

# ── Database (Supabase) ──────────────────────────────────
# From: Supabase → Project Settings → Database → Connection string

# Transaction Pooler (port 6543) — used by serverless functions
# Example: postgresql://postgres.xxxxx:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres"

# Direct connection (port 5432) — used by prisma migrate deploy
# Example: postgresql://postgres:[password]@db.xxxxx.supabase.co:5432/postgres
# OR use Session Pooler URL if your network doesn't support IPv6
DIRECT_URL="postgresql://postgres:[password]@db.jvlocgstrcyurqibgkuj.supabase.co:5432/postgres"

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-long-random-secret-here"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# ── AI (Google Gemini) ───────────────────────────────────
# From: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── App ──────────────────────────────────────────────────
NODE_ENV="production"
# Set this AFTER your first Vercel deploy to your actual URL
# e.g. https://job-costing.vercel.app
FRONTEND_URL="https://your-app.vercel.app"
