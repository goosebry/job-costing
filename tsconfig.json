{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./job-costing-app/backend/src/*"]
    }
  },
  "include": ["api/**/*", "job-costing-app/backend/src/**/*"],
  "exclude": ["node_modules", "job-costing-app/frontend"]
}
